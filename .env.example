# --- Postgres -------------------------------------------------------------
# Local Docker Compose default. For Neon/Supabase, paste the full pooled URL.
DATABASE_URL=postgres://opencopy:opencopy@localhost:5432/opencopy

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-string

# Trusts hosts behind reverse proxies in self-hosted deployments.
AUTH_TRUST_HOST=true

# --- Magic-link email (optional in dev; dev credentials provider is on by default) -----
# Resend example:
# AUTH_RESEND_KEY=
# Or any SMTP provider:
# EMAIL_SERVER=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=OpenCopy <noreply@example.com>

# --- Server-side master key for encrypting per-user API keys at rest ------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-random-string

# --- Public app URL -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev mode -------------------------------------------------------------
# When true, exposes a username/password credentials provider in the auth UI
# so you can sign in without configuring email. Disable in production.
DEV_AUTH_ENABLED=true
