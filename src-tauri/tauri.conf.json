{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenCopy",
  "version": "2.5.0",
  "identifier": "io.opencopy.desktop",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:prepare",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCopy",
        "width": 720,
        "height": 520,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/agus-pleso/OpenCopy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OTk4MjVGMEVCMzY1Q0YKUldUUFpiTU9YNEtaWnNNNWJhMWNhVDFPdHNtY3hmc09obis5UjZTOUtzYWNlQUhwR2RHemk4YXIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI copywriting workspace",
    "longDescription": "OpenCopy is a self-hosted AI copywriting workspace. The installer bundles everything you need to run it locally — no Docker, no external accounts.",
    "externalBin": ["binaries/node"],
    "resources": ["server/**/*"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
